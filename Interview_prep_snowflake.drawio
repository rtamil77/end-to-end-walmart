        </mxCell>
        <mxCell id="mnWqI2OcNRHywK7y5KrW-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 16px;&quot;&gt;Query Processing Layer&lt;/font&gt;&lt;/b&gt;" vertex="1">
