        <mxCell id="xCYwbE6woSv3HyU5htzc-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="1. 100-250MB compressed snowflake recom - Gzip(Kinesis Firehose- 1to128 MIB,time - 0to900 secs)&lt;div&gt;2.&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;SHOW PIPES;&lt;/span&gt;&lt;div&gt;3. SELECT SYSTEM$PIPE_STATUS(&#39;pipe_name&#39;);&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;ALTER PIPE &amp;lt;pipe_name&amp;gt; SET PIPE_EXECUTION_PAUSED = true;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4. create or replace pipe &amp;lt;name&amp;gt; auto_ingest=true as&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="309" x="-245.5" y="1000" as="geometry" />
        </mxCell>
