an&gt;&lt;span class=&quot;token token punctuation&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;CURRENT_TIMESTAMP&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;    &lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;&lt;span class=&quot;token token punctuation&quot;&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; user-select: text;&quot;&gt;&lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;&lt;br&gt;FROM&lt;/span&gt; SNOWFLAKE&lt;span class=&quot;token token punctuation&quot;&gt;.&lt;/span&gt;ACCOUNT_USAGE&lt;span class=&quot;token token punctuation&quot;&gt;.&lt;/span&gt;LOAD_HISTORY&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; user-select: text;&quot;&gt;&lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;WHERE&lt;/span&gt; table_name &lt;span class=&quot;token token operator&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;token token&quot;&gt;&#39;DEPARTMENT_RAW&#39;&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: