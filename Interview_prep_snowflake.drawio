        <mxCell id="6H9L2HXnc4uxpHlHWh3n-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b&gt;Materialization&lt;/b&gt;:&lt;div&gt;1. view - creates a view&lt;/div&gt;&lt;div&gt;2. table - creates a table (full rebuild, complete table)&lt;/div&gt;&lt;div&gt;3. incremental - creates (large fact/event tables with reliable ways to identify new or changed records)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;{&lt;span class=&quot;token token operator&quot;&gt;%&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;if&lt;/span&gt; is_incremental&lt;span class=&quot;token token punctuation&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt; &lt;span class=&quot;token token operator&quot;&gt;%&lt;/span&gt;}&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;&lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;where&lt;/span&gt; updated_at &lt;span class=&quot;token token operator&quot;&gt;&amp;gt;=&lt;/span&gt; &lt;span class=&quot;token token punctuation&quot;&gt;(&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;    &lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;select&lt;/span&gt; &lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;coalesce&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;(&lt;/span&gt;&lt;span class=&quot;token token&quot;&gt;max&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;(&lt;/span&gt;updated_at&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;,&lt;/span&gt; &lt;span class=&quot;token token&quot;&gt;&#39;1900-01-01&#39;&lt;/span&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;    &lt;span class=&quot;token token&quot; style=&quot;font-weight: bolder;&quot;&gt;from&lt;/span&gt; {{ this }}&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;&lt;span class=&quot;token token punctuation&quot;&gt;)&lt;/span&gt;&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;{&lt;span class=&quot;token token operator&quot;&gt;%&lt;/span&gt; endif &lt;span class=&quot;token token operator&quot;&gt;%&lt;/span&gt;}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;opacity: 1; font-size: inherit; line-height: 1.42857; flex-shrink: 0; padding: 8px; text-align: right; user-select: text;&quot;&gt;incremental_startegy = merge | append | delete+insert | insert_overwrite | microbatch&lt;/span&gt;&lt;/div&gt;&lt;div&gt;4. ephermal - temporary&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
