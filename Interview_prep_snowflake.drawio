          <mxGeometry height="160" width="354" x="126" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="xCYwbE6woSv3HyU5htzc-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="1. Task name, warehouse, def, triggering mechanism&lt;div&gt;2.&amp;nbsp;https://github.com/rtamil77/real_time_stream_scd1_aws_snowflake/blob/main/snowflake/Stream_Task.sql&lt;div&gt;&lt;div&gt;4. 100 - child task (AFTER T1,T2 OR SCHEDULE = &#39;30 MINUTE&#39;),&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;1000&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;5. Same Database, Schema, task owner&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;6. Global privilege &quot;Execute Task&quot;, Account Admin&lt;/div&gt;&lt;div&gt;7. Alter Task &amp;lt;name&amp;gt; Resume|Suspend&lt;/div&gt;&lt;div&gt;8. Create Task T1\ Warehouse=mywh\ Schedule=&#39;1 minute&#39;\ AS\&amp;nbsp;&lt;/div&gt;&lt;div&gt;COPY INTO &amp;lt;tab_name&amp;gt; From $my_stage:&lt;/div&gt;&lt;div&gt;9. select * from&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;TABLE(I&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;NFORMATION_SCHEMA.TASK_HISTORY(&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; TASK_NAME =&amp;gt; &#39;EMPLOYEE_SCD1_TASK&#39;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
