;/span&gt;&lt;span style=&quot;color: rgb(28, 26, 25);&quot;&gt; &lt;/span&gt;&lt;span style=&quot;color: rgb(0, 121, 162);&quot;&gt;execute&lt;/span&gt;&lt;span style=&quot;color: rgb(28, 26, 25);&quot;&gt; %} {% endif %}, {% snapshot &amp;lt;name&amp;gt; %} {% endsnapshot%},&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#1c1a19&quot; face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;white-space: pre; background-color: rgb(253, 253, 253);&quot;&gt;{% macro &amp;lt;name&amp;gt; %} &lt;/span&gt;&lt;/font&gt;&lt;span style=&quot;background-color: rgb(253, 253, 253); color: rgb(28, 26, 25); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;{% endmacro %} &lt;/span&gt;&lt;span style=&quot;background-color: rgb(253, 253, 253); color: rgb(28, 26, 25); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;{% set sql %} &lt;/span&gt;&lt;span style=&quot;background-color: rgb(253, 253, 253); color: rgb(28, 26, 25); font-family: Menlo, Monaco, &amp;quot;Courier New&amp;quot;, monospace; white-space: pre;&quot;&gt;{% endset %}&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#c13900&quot; face=&quot;Menlo, Monaco, Courier New, monospace&quot;&gt;&lt;span style=&quot;white-space: pre; background-color: rgb(253, 253, 253);&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
