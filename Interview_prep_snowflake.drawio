 style=&quot;color: #006dce;&quot;&gt;=&lt;/span&gt; TRUE;&lt;/div&gt;&lt;div&gt;{% &lt;span style=&quot;color: #006dce;&quot;&gt;endset&lt;/span&gt; %}&lt;/div&gt;&lt;br&gt;&lt;div&gt;{% &lt;span style=&quot;color: #006dce;&quot;&gt;if&lt;/span&gt; &lt;span style=&quot;color: #0079a2;&quot;&gt;execute&lt;/span&gt; %}&lt;/div&gt;&lt;div&gt;    {% &lt;span style=&quot;color: #006dce;&quot;&gt;set&lt;/span&gt; &lt;span style=&quot;color: #0079a2;&quot;&gt;result&lt;/span&gt; &lt;span style=&quot;color: #006dce;&quot;&gt;=&lt;/span&gt; &lt;span style=&quot;color: #0079a2;&quot;&gt;run_query&lt;/span&gt;&lt;span style=&quot;color: #2f2d2c;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;color: #0079a2;&quot;&gt;sql&lt;/span&gt;&lt;span style=&quot;color: #2f2d2c;&quot;&gt;)&lt;/span&gt; %}&lt;/div&gt;&lt;div&gt;{% &lt;span style=&quot;color: #006dce;&quot;&gt;endif&lt;/span&gt;%}&lt;/div&gt;&lt;br&gt;&lt;div&gt;{% &lt;span style=&quot;color: #006dce;&quot;&gt;endmacro&lt;/span&gt; %}&lt;/div&gt;&lt;/div&gt;" vertex="1">
